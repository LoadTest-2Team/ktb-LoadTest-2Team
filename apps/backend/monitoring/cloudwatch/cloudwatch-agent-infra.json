{
  "agent": {
    "region": "__AWS_REGION__",
    "metrics_collection_interval": 60,
    "debug": false,
    "logfile": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log"
  },
  "metrics": {
    "namespace": "KTB/EC2",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "InstanceType": "${aws:InstanceType}"
    },
    "metrics_collected": {
      "cpu": {
        "resources": ["*"],
        "totalcpu": true,
        "measurement": [
          {"name": "cpu_usage_iowait", "unit": "Percent"},
          {"name": "cpu_usage_steal", "unit": "Percent"}
        ]
      },
      "mem": {
        "measurement": [
          {"name": "mem_used_percent", "unit": "Percent"},
          {"name": "mem_available_percent", "unit": "Percent"}
        ]
      },
      "disk": {
        "resources": ["/"],
        "ignore_file_system_types": [
          "sysfs", "devtmpfs", "tmpfs", "overlay", "squashfs", "proc", "devpts"
        ],
        "measurement": [
          {"name": "disk_used_percent", "unit": "Percent"},
          {"name": "disk_inodes_free", "unit": "Count"}
        ]
      },
      "diskio": {
        "resources": ["*"],
        "measurement": [
          {"name": "diskio_iops_in_progress", "unit": "Count"},
          {"name": "diskio_io_time", "unit": "Milliseconds"}
        ]
      },
      "net": {
        "resources": ["*"],
        "measurement": [
          {"name": "net_bytes_recv", "unit": "Bytes"},
          {"name": "net_bytes_sent", "unit": "Bytes"}
        ]
      },
      "netstat": {
        "measurement": [
          {"name": "netstat_tcp_established", "unit": "Count"},
          {"name": "netstat_tcp_time_wait", "unit": "Count"}
        ]
      },
      "processes": {
        "measurement": [
          {"name": "processes_running", "unit": "Count"},
          {"name": "processes_blocked", "unit": "Count"},
          {"name": "processes_zombies", "unit": "Count"}
        ]
      },
      "swap": {
        "measurement": [
          {"name": "swap_used_percent", "unit": "Percent"}
        ]
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "__LOG_GROUP_PREFIX__/ec2/system",
            "log_stream_name": "{instance_id}-syslog",
            "retention_in_days": 14,
            "timezone": "Local"
          },
          {
            "file_path": "/var/log/messages",
            "log_group_name": "__LOG_GROUP_PREFIX__/ec2/system",
            "log_stream_name": "{instance_id}-messages",
            "retention_in_days": 14,
            "timezone": "Local"
          }
        ]
      }
    },
    "force_flush_interval": 5
  }
}
