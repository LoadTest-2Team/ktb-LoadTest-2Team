{
  "agent": {
    "region": "__AWS_REGION__",
    "metrics_collection_interval": 60,
    "debug": false,
    "logfile": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log"
  },
  "metrics": {
    "namespace": "KTB/EC2",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "InstanceType": "${aws:InstanceType}"
    },
    "metrics_collected": {
      "cpu": {
        "resources": ["*"],
        "totalcpu": true,
        "measurement": [
          {"name": "cpu_usage_iowait", "unit": "Percent"},
          {"name": "cpu_usage_steal", "unit": "Percent"}
        ]
      },
      "mem": {
        "measurement": [
          {"name": "mem_used_percent", "unit": "Percent"},
          {"name": "mem_available_percent", "unit": "Percent"}
        ]
      },
      "disk": {
        "resources": ["/"],
        "ignore_file_system_types": [
          "sysfs", "devtmpfs", "tmpfs", "overlay", "squashfs", "proc", "devpts"
        ],
        "measurement": [
          {"name": "disk_used_percent", "unit": "Percent"},
          {"name": "disk_inodes_free", "unit": "Count"}
        ]
      },
      "diskio": {
        "resources": ["*"],
        "measurement": [
          {"name": "diskio_iops_in_progress", "unit": "Count"},
          {"name": "diskio_io_time", "unit": "Milliseconds"}
        ]
      },
      "net": {
        "resources": ["*"],
        "measurement": [
          {"name": "net_bytes_recv", "unit": "Bytes"},
          {"name": "net_bytes_sent", "unit": "Bytes"}
        ]
      },
      "netstat": {
        "measurement": [
          {"name": "netstat_tcp_established", "unit": "Count"},
          {"name": "netstat_tcp_time_wait", "unit": "Count"}
        ]
      },
      "processes": {
        "measurement": [
          {"name": "processes_running", "unit": "Count"},
          {"name": "processes_blocked", "unit": "Count"},
          {"name": "processes_zombies", "unit": "Count"}
        ]
      },
      "swap": {
        "measurement": [
          {"name": "swap_used_percent", "unit": "Percent"}
        ]
      },
      "procstat": [
        {
          "pattern": "app.jar",
          "measurement": [
            "cpu_usage",
            "memory_rss",
            "num_threads",
            "read_bytes",
            "write_bytes"
          ]
        }
      ]
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "__BACKEND_HOME__/logs/app.log",
            "log_group_name": "__LOG_GROUP_PREFIX__/backend/application",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 14,
            "timezone": "UTC"
          },
          {
            "file_path": "__BACKEND_HOME__/logs/app.log",
            "log_group_name": "__LOG_GROUP_PREFIX__/backend/error",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30,
            "timezone": "UTC",
            "filters": [
              {
                "type": "include",
                "expression": "\"level\":\"ERROR\""
              }
            ]
          },
          {
            "file_path": "__BACKEND_HOME__/logs/access.*.log",
            "log_group_name": "__LOG_GROUP_PREFIX__/backend/access",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 14,
            "timezone": "Local"
          },
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "__LOG_GROUP_PREFIX__/ec2/system",
            "log_stream_name": "{instance_id}-syslog",
            "retention_in_days": 14,
            "timezone": "Local"
          },
          {
            "file_path": "/var/log/messages",
            "log_group_name": "__LOG_GROUP_PREFIX__/ec2/system",
            "log_stream_name": "{instance_id}-messages",
            "retention_in_days": 14,
            "timezone": "Local"
          }
        ]
      }
    },
    "metrics_collected": {
      "prometheus": {
        "log_group_name": "__LOG_GROUP_PREFIX__/backend/prometheus",
        "prometheus_config_path": "/opt/aws/amazon-cloudwatch-agent/etc/prometheus.yaml",
        "emf_processor": {
          "metric_declaration_dedup": true,
          "metric_namespace": "KTB/Application",
          "metric_unit": {
            "http_server_requests_seconds_count": "Count",
            "http_server_requests_seconds_sum": "Seconds",
            "http_server_requests_concurrent": "Count",
            "http_server_success_latency_seconds": "Seconds",
            "http_server_success_latency_seconds_count": "Count",
            "http_server_success_latency_seconds_sum": "Seconds",
            "http_server_success_slo_exceeded_total": "Count",
            "jvm_memory_used_bytes": "Bytes",
            "jvm_memory_committed_bytes": "Bytes",
            "jvm_threads_live_threads": "Count",
            "jvm_threads_peak_threads": "Count",
            "jvm_threads_states_threads": "Count",
            "socketio_concurrent_users": "Count",
            "socketio_events_total": "Count",
            "socketio_messages_total": "Count",
            "socketio_messages_errors_total": "Count",
            "socketio_messages_processing_time_seconds": "Seconds",
            "socketio_messages_processing_time_seconds_count": "Count",
            "socketio_messages_processing_time_seconds_sum": "Seconds"
          },
          "metric_declaration": [
            {
              "source_labels": ["job"],
              "label_matcher": "^ktb-backend$",
              "dimensions": [["application", "host", "outcome"]],
              "metric_selectors": [
                "^http_server_requests_seconds_(count|sum)$"
              ]
            },
            {
              "source_labels": ["job"],
              "label_matcher": "^ktb-backend$",
              "dimensions": [["application", "host"]],
              "metric_selectors": [
                "^http_server_requests_concurrent$",
                "^http_server_success_latency_seconds_(count|sum|max)$"
              ]
            },
            {
              "source_labels": ["job", "quantile"],
              "label_matcher": "^ktb-backend;(0\\.95|0\\.99)$",
              "dimensions": [["application", "host", "quantile"]],
              "metric_selectors": [
                "^http_server_success_latency_seconds$"
              ]
            },
            {
              "source_labels": ["job"],
              "label_matcher": "^ktb-backend$",
              "dimensions": [["application", "host", "threshold"]],
              "metric_selectors": [
                "^http_server_success_slo_exceeded_total$"
              ]
            },
            {
              "source_labels": ["job"],
              "label_matcher": "^ktb-backend$",
              "dimensions": [["application", "host", "area", "id"]],
              "metric_selectors": [
                "^jvm_memory_(used|committed)_bytes$"
              ]
            },
            {
              "source_labels": ["job"],
              "label_matcher": "^ktb-backend$",
              "dimensions": [["application", "host"]],
              "metric_selectors": [
                "^jvm_threads_(live|peak)_threads$"
              ]
            },
            {
              "source_labels": ["job"],
              "label_matcher": "^ktb-backend$",
              "dimensions": [["application", "host", "state"]],
              "metric_selectors": [
                "^jvm_threads_states_threads$"
              ]
            },
            {
              "source_labels": ["job"],
              "label_matcher": "^ktb-backend$",
              "dimensions": [["application", "host", "name"]],
              "metric_selectors": [
                "^executor_(active_threads|pool_max_threads|pool_size_threads|queued_tasks|queue_remaining_tasks)$",
                "^tomcat_threads_.*$"
              ]
            },
            {
              "source_labels": ["job"],
              "label_matcher": "^ktb-backend$",
              "dimensions": [["application", "host"]],
              "metric_selectors": [
                "^socketio_concurrent_users$"
              ]
            },
            {
              "source_labels": ["job"],
              "label_matcher": "^ktb-backend$",
              "dimensions": [["application", "host", "event_type"]],
              "metric_selectors": [
                "^socketio_events_total$"
              ]
            },
            {
              "source_labels": ["job"],
              "label_matcher": "^ktb-backend$",
              "dimensions": [["application", "host", "status", "message_type"]],
              "metric_selectors": [
                "^socketio_messages_total$",
                "^socketio_messages_processing_time_seconds_(count|sum|max)$"
              ]
            },
            {
              "source_labels": ["job", "quantile"],
              "label_matcher": "^ktb-backend;(0\\.95|0\\.99)$",
              "dimensions": [["application", "host", "status", "message_type", "quantile"]],
              "metric_selectors": [
                "^socketio_messages_processing_time_seconds$"
              ]
            },
            {
              "source_labels": ["job"],
              "label_matcher": "^ktb-backend$",
              "dimensions": [["application", "host", "error_type"]],
              "metric_selectors": [
                "^socketio_messages_errors_total$"
              ]
            }
          ]
        }
      }
    },
    "force_flush_interval": 5
  }
}
